<resources>
    <color name="surface">#FFFFFF</color>
    <color name="canvas">#F9FAFB</color>
    <color name="ink">#111827</color>
    <color name="body">#4B5563</color>
    <color name="secondary">#667085</color>
    <color name="hairline">#CCE5E7EB</color>
    <color name="action">#2563EB</color>
    <style name="WattUpTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/body</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:buttonStyle">@style/WattUpButton</item>
    </style>
    <style name="WattUpButton" parent="android:style/Widget.Material.Light.Button">
        <item name="android:background">@drawable/control</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
