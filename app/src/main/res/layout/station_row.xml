<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:background="@drawable/control" android:minHeight="76dp" android:padding="18dp" android:elevation="1dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/row_name" android:text="" android:textSize="17sp" android:textColor="@color/ink" android:layout_weight="0" android:padding="0dp" android:textStyle="bold" />
        <TextView android:id="@+id/row_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:textColor="@color/secondary" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/row_badge" android:text="" android:textSize="13sp" android:textColor="@color/body" android:padding="8dp" android:layout_margin="6dp" android:background="@color/canvas" />
</LinearLayout>
